---
import { url } from '../lib/paths';
interface Props { title?: string; slug?: string; }
const {title,slug}=Astro.props;
const surveyUrl='https://wj.qq.com/s2/28094347/s3u4/';
const pageUrl=new URL(slug?url(`concepts/${slug}`):url(),Astro.site||'https://betterci.github.io').href;
const context=`${title?'词条：'+title:'反馈页面：n³ Hearingpedia 首页'}\n链接：${pageUrl}`;
---
<section class="feedback-panel" id="feedback" aria-labelledby="feedback-heading" data-pagefind-ignore>
  <div class="eyebrow">Help improve this knowledge</div>
  <h2 id="feedback-heading">{title?'帮助完善这个词条':'词条增减与其他建议'}</h2>
  <p>{title?`关于「${title}」的解释、术语、图片或引用，你有什么修改建议？欢迎指出具体章节，并附上理由或参考依据。`:'你希望增加、删除或合并哪些词条？对知识分类、页面功能或使用体验有什么建议？欢迎通过问卷告诉我们。'}</p>
  <div class="feedback-actions">
    <a class="button primary" href={surveyUrl} target="_blank" rel="noopener noreferrer">填写建议问卷 <span aria-hidden="true">↗</span><span class="sr-only">（腾讯问卷，新窗口打开）</span></a>
    <button class="button copy-feedback" type="button" hidden>{title?'复制词条名称与链接':'复制首页链接'}</button>
  </div>
  {title && <p class="feedback-help">可先复制词条信息，粘贴到问卷的“针对具体某个词条的内容建议”中。</p>}
  <p class="feedback-help">建议通过腾讯问卷提交，请在问卷中填写联系方式。由维护者核对处理后更新网站。</p>
  <details class="feedback-context"><summary>查看{title?'词条':'页面'}信息</summary><textarea readonly aria-label="可复制的反馈页面信息" rows="3">{context}</textarea></details>
  <p class="feedback-result" role="status" aria-live="polite"></p>
</section>
<script>
  for(const panel of document.querySelectorAll<HTMLElement>('.feedback-panel')){
    const button=panel.querySelector<HTMLButtonElement>('.copy-feedback')!;
    const info=panel.querySelector<HTMLTextAreaElement>('.feedback-context textarea')!;
    const result=panel.querySelector<HTMLElement>('.feedback-result')!;
    button.hidden=false;
    button.addEventListener('click',async()=>{
      try{
        await navigator.clipboard.writeText(info.value);
        result.textContent='已复制，可粘贴到问卷中。';
      }catch{
        panel.querySelector<HTMLDetailsElement>('.feedback-context')!.open=true;
        info.focus();info.select();
        result.textContent='请手动复制上方已选中的页面信息。';
      }
    });
  }
</script>
<style>
  .feedback-panel{margin:40px 0 56px;padding:30px;border:1px solid #d2dfdd;border-radius:12px;background:#f5faf8;scroll-margin-top:90px}
  h2{font-size:24px;margin:10px 0 12px}p{font-size:14px;line-height:1.9;color:var(--muted);max-width:760px}
  .feedback-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:22px 0 16px}
  button{cursor:pointer}.copy-feedback[hidden]{display:none}.feedback-help{font-size:12px;margin:7px 0}
  .feedback-context{font-size:12px;color:var(--muted);margin-top:14px}.feedback-context summary{cursor:pointer}
  textarea{display:block;width:100%;max-width:760px;box-sizing:border-box;margin-top:10px;padding:10px 12px;border:1px solid #cbdad6;border-radius:5px;background:white;color:var(--ink);font-family:inherit;font-size:12px;line-height:1.8;resize:vertical}
  .feedback-result{font-size:12px;color:#216658;margin-top:12px}.feedback-result:empty{display:none}
  @media(max-width:600px){.feedback-panel{padding:22px 18px}h2{font-size:22px}.feedback-actions{align-items:stretch;flex-direction:column}.feedback-actions .button{justify-content:center}}
</style>
