---
import { introductoryPaths } from '../data/paths';
import { url } from '../lib/paths';
---
<div class="intro-path-grid">
  {introductoryPaths.map(path => <article class="intro-path-card">
    <div class="eyebrow">{path.english}</div>
    <h3>{path.title}</h3>
    <p>{path.description}</p>
    <p class="intro-goal"><strong>读完可以</strong>{path.goal}</p>
    <div class="intro-path-actions">
      <a class="text-link" href={url('learn') + '#' + path.id}>查看 {path.steps.length} 步路线 ↗</a>
      <a class="button" href={url('concepts/' + path.steps[0].slug) + '?path=' + path.id}>开始第一步 →</a>
    </div>
  </article>)}
</div>
<style>
  .intro-path-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .intro-path-card{display:flex;flex-direction:column;padding:25px;border:1px solid #dce4e8;border-radius:12px;background:#eef4f6}
  .intro-path-card:nth-child(2){background:#f2eff8;border-color:#e4dff0}.intro-path-card:nth-child(3){background:#eef6f1;border-color:#dce9df}
  .intro-path-card .eyebrow{font-size:9px}.intro-path-card h3{font-size:22px;margin:15px 0 13px}
  .intro-path-card p{font-size:14px;line-height:1.85;color:var(--muted)}.intro-goal{margin:18px 0 24px}.intro-goal strong{display:block;font-size:12px;color:var(--ink);margin-bottom:5px}
  .intro-path-actions{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-top:auto}.intro-path-actions .button{padding:8px 12px;font-size:12px}
  @media(max-width:900px){.intro-path-grid{grid-template-columns:1fr}.intro-path-card{padding:22px}.intro-goal{margin:13px 0 18px}}
</style>
