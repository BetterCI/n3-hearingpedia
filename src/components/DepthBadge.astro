---
interface Props { depth?: 'standard' | 'in-depth'; }
const { depth = 'in-depth' } = Astro.props;
const isBasic = depth === 'standard';
---
<span class:list={['depth-badge', { 'basic-badge': isBasic }]} title={isBasic ? '系统介绍核心定义、机制和应用，专业审阅状态另行标注' : '已完成系统扩写，专业审阅状态另行标注'} data-pagefind-ignore>
  <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 5.2C7.9 3.8 5.3 3.5 2.5 4v11.2c2.8-.5 5.4-.2 7.5 1.2m0-11.2c2.1-1.4 4.7-1.7 7.5-1.2v11.2c-2.8-.5-5.4-.2-7.5 1.2V5.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M5 7.2l2.3.4M5 10.2l2.3.4m5.4-3 2.3-.4m-2.3 3.4 2.3-.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
  {isBasic ? '基础词条' : '深度词条'}
</span>
<style>
  .depth-badge{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;border:1px solid #b9d8d1;border-radius:5px;padding:3px 7px;background:#eaf5f1;color:#216658;font-size:11px;font-weight:600;line-height:1.4;letter-spacing:0}
  .basic-badge{border-color:#bfd6e8;background:#edf5fc;color:#285f86}
  svg{flex-shrink:0}
</style>
