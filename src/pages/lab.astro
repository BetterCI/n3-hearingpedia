---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
import SpectrogramLaunch from '../components/SpectrogramLaunch.astro';
import BasilarLaunch from '../components/BasilarLaunch.astro';
const plans=[{title:'听觉滤波器',note:'比较频率窗口与带宽，连接凹口噪声实验的直觉。',slug:'auditory-filter'},{title:'时域包络',note:'观察调制深度与频率如何改变波形和幅度轮廓。',slug:'temporal-envelope'},{title:'声码器',note:'逐项查看分析、包络、载波和合成参数的作用。',slug:'vocoder'}];
---
<BaseLayout title="Lab · 互动实验"><div class="container"><div class="page-intro"><div class="eyebrow">Interactive lab / 互动实验</div><h1>从理解概念，到观察变化。</h1><p>把抽象的声音结构变成可以亲手探索的图像。从实时语谱图开始，改变声音与分析参数，观察每一次变化。</p></div><SpectrogramLaunch /><BasilarLaunch /><section class="section"><div class="section-heading"><h2>后续实验路线图</h2></div><div class="roadmap-list">{plans.map((p,i)=><div><span class="phase-label">PLANNED / {String(i+1).padStart(2,'0')}</span><h2>{p.title}</h2><p>{p.note}</p><p style="margin-top:18px"><a class="text-link" href={url(`concepts/${p.slug}`)}>先阅读相关词条 ↗</a></p></div>)}</div></section></div></BaseLayout>
