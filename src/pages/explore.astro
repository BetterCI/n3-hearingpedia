---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptCard from '../components/ConceptCard.astro';
import { domains } from '../data/domains';
import { knowledgeAreas } from '../data/knowledge';
import { url } from '../lib/paths';
const concepts=(await getCollection('concepts')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Explore · 知识体系"><div class="container">
<div class="page-intro"><div class="eyebrow">A knowledge system for hearing science</div><h1>从声音，到功能与方法。</h1><p>六个知识层面组织 {concepts.length} 个百科词条。学科分类允许交叉，词条类型区分结构、物理量、感知功能、测试指标和模型。</p></div>
<section class="section"><div class="knowledge-overview">{knowledgeAreas.map(a=><a href={'#'+a.id} style={'--area-color:'+a.color}><span>{a.english}</span><h2>{a.title}</h2><p>{a.note}</p><strong>{concepts.filter(c=>c.data.knowledge_area===a.id).length} 个词条 ↘</strong></a>)}</div></section>
{knowledgeAreas.map(a=><section class="section" id={a.id}><div class="section-heading"><div><div class="eyebrow">{a.english}</div><h2>{a.title}</h2><p>{a.note}</p></div><a class="text-link" href={url('map')}>三维知识地图 ↗</a></div><div class="concept-grid">{concepts.filter(c=>c.data.knowledge_area===a.id).map(concept=><ConceptCard concept={concept}/>)}</div></section>)}
<section class="section"><details class="discipline-index"><summary>按学科浏览：{domains.length} 个领域索引</summary><p>一个词条可以关联多个学科；这与上方的主要知识层面互补。</p><div class="domain-grid">{domains.map(d=><a class="domain-card" href={url('domains/'+d.id)}><span class="symbol" aria-hidden="true">{d.symbol}</span><h2>{d.zh}</h2><span class="en-label">{d.name}</span><p>{d.note}</p><span class="domain-count">{concepts.filter(c=>c.data.categories.includes(d.id)).length} 个词条 ↗</span></a>)}</div></details></section>
</div></BaseLayout>
<style>.knowledge-overview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.knowledge-overview>a{padding:24px;background:#fff;border:1px solid var(--line);border-left:3px solid var(--area-color);border-radius:8px}.knowledge-overview span{font-size:10px;color:var(--muted)}.knowledge-overview h2{font-size:20px;margin:11px 0}.knowledge-overview p{font-size:12px;line-height:1.8;color:var(--muted);min-height:42px}.knowledge-overview strong{font-size:11px;color:var(--accent);font-weight:500}.discipline-index{padding:24px;border:1px solid var(--line);border-radius:9px}.discipline-index summary{cursor:pointer;color:var(--accent)}.discipline-index>p{font-size:12px;color:var(--muted);margin:20px 0}@media(max-width:760px){.knowledge-overview{grid-template-columns:1fr 1fr}}@media(max-width:430px){.knowledge-overview{grid-template-columns:1fr}}</style>
