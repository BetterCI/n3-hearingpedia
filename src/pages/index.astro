---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptCard from '../components/ConceptCard.astro';
import NetworkArt from '../components/NetworkArt.astro';
import RandomConceptFigure from '../components/RandomConceptFigure.astro';
import DepthBadge from '../components/DepthBadge.astro';
import FeedbackPanel from '../components/FeedbackPanel.astro';
import { url } from '../lib/paths';
import { introductoryPaths } from '../data/paths';
import IntroPathCards from '../components/IntroPathCards.astro';
import { knowledgeAreas } from '../data/knowledge';
import { homepageFeaturedSlugs, homepageRecentCount } from '../data/homepage';
import { getConceptPublicationUpdates, compareConceptPublication } from '../lib/concept-publication';
const concepts = (await getCollection('concepts')).sort((a,b) => a.data.order - b.data.order);
const publicationUpdates = getConceptPublicationUpdates();
const publicationRanks = new Map([...publicationUpdates].map(([slug,update])=>[slug,update.rank]));
const recent = [...concepts].sort((a,b) => compareConceptPublication(a,b,publicationRanks)).slice(0,homepageRecentCount);
const inDepth = concepts.filter(c=>c.data.depth==='in-depth' && c.data.kind!=='person');
const featured = homepageFeaturedSlugs.map(slug => {
  const concept = inDepth.find(entry => entry.data.slug === slug);
  if (!concept) throw new Error(`Missing featured in-depth entry: ${slug}`);
  return concept;
});
---
<BaseLayout>
  <div class="container">
    <aside class="partner-site" aria-label="合作网站">
      <span class="partner-label">合作网站</span>
      <a href="https://betterci.github.io/hearing-paper-monitor/" target="_blank" rel="noopener noreferrer">听觉研究论文追踪 <span aria-hidden="true">↗</span></a>
      <span class="partner-description">关注听觉科学的新近研究</span>
    </aside>
    <section class="hero">
      <div>
        <div class="eyebrow">A living knowledge network</div>
        <h1><span class="hero-n">n³</span>Hearingpedia</h1>
        <p class="hero-subtitle">An AI-native Knowledge System for Hearing Science</p>
        <p class="hero-description">从声音到听觉。<br />连接机制、感知与工程，<br />让每一个概念都有迹可循。</p>
        <form class="hero-search" action={url('search')} method="get" role="search">
          <span class="search-symbol" aria-hidden="true">⌕</span>
          <label class="sr-only" for="hero-query">搜索听觉科学词条</label>
          <input id="hero-query" type="search" name="q" placeholder="搜索概念、英文术语或研究方法…" required />
          <button type="submit">搜索 ↗</button>
        </form>
        <div class="hero-actions"><a class="button primary" href={url('explore')}>浏览概念 <span>↗</span></a><a class="button" href={url('map')}>三维知识地图</a><a class="button" href={url('learn')}>选择学习路线</a></div>
        <p class="hero-note">面向学习与研究 · 连接概念、方法与科学证据</p>
      </div>
      <NetworkArt />
    </section>
    <div class="project-strip">
      <div class="strip-intro"><strong>一个概念，一页清晰的解释。</strong>沿着关联，找到理解下一个问题的入口。</div>
      <div class="strip-stats"><span><strong>{concepts.length}</strong>百科词条</span><span><strong>{knowledgeAreas.length}</strong>知识层面</span><span><strong>{introductoryPaths.length}</strong>入门路线</span></div>
    </div>
    {recent.length>0 && <section class="recent-updates" id="latest-updates" aria-labelledby="recent-updates-title">
      <div class="recent-updates-heading"><h2 id="recent-updates-title">最新更新</h2><p>词条新增与修订</p></div>
      <ul class="recent-updates-list">{recent.map(concept=>{const date=publicationUpdates.get(concept.data.slug)?.date || concept.data.last_updated;return <li><a class="recent-update-link" href={url(`concepts/${concept.data.slug}`)}><span>{concept.data.title}</span><span aria-hidden="true">↗</span></a><time datetime={date}>{date.replaceAll('-','.')}</time></li>;})}</ul>
    </section>}
    <section class="section" aria-labelledby="intro-paths-title">
      <div class="section-heading"><div><div class="eyebrow">Start with a question</div><h2 id="intro-paths-title">先回答一个问题</h2><p>每条路线 4 步，先读导言和指定章节，再按需深入。</p></div><a class="text-link" href={url('learn')}>全部学习路线 ↗</a></div>
      <IntroPathCards />
    </section>
    {inDepth.length>0 && <section class="section featured-section" aria-labelledby="in-depth-title">
      <div class="section-heading"><div><div class="eyebrow">Read in depth</div><h2 id="in-depth-title">精选深度词条</h2><p>从声学基础与听觉机制，到感知、测量、康复技术与计算模型，探索听觉科学的核心问题。</p></div><a class="text-link" href={url('explore')}>浏览全部 {inDepth.length} 篇深度词条 ↗</a></div>
      <div class="concept-grid" id="in-depth-featured">{featured.map(concept=><ConceptCard concept={concept}/>)}</div>
    </section>}
    <section class="section" aria-labelledby="theme-entry-title">
      <div class="section-heading"><div><div class="eyebrow">Browse by theme</div><h2 id="theme-entry-title">按主题找入口</h2><p>从知识层面进入完整目录，也可以围绕研究任务阅读。</p></div><a class="text-link" href={url('map')}>探索知识关系 ↗</a></div>
      <div class="theme-entry-grid">{knowledgeAreas.map(area=><a class="theme-entry" href={url('explore')+'#'+area.id} style={'--area-color:'+area.color}><span>{area.english}</span><h3>{area.title}</h3><p>{area.note}</p><strong>{concepts.filter(c=>c.data.knowledge_area===area.id).length} 个词条 ↗</strong></a>)}</div>
      <nav class="additional-entries" aria-label="其他知识入口"><a href={url('topics')}>研究专题 <span>围绕研究任务找词条 ↗</span></a><a href={url('people')}>听觉研究人物 <span>从代表工作了解学术沿革 ↗</span></a></nav>
    </section>
    <RandomConceptFigure concepts={inDepth} />
    <section class="section"><div class="note-panel"><div><h3>有来源，也有状态。</h3><p><DepthBadge depth="standard" /> 系统介绍核心定义、机制和应用；<DepthBadge /> 提供更完整的研究证据、模型与专题讨论。专业审阅进度在各词条中单独标注；每次更新保留引用和变更记录。</p></div><a class="text-link" href={url('contribute')}>了解贡献流程 ↗</a></div></section>
    <FeedbackPanel />
  </div>
</BaseLayout>
<style>
  .recent-updates{display:grid;grid-template-columns:130px minmax(0,1fr);align-items:center;gap:24px;margin-top:22px;padding:18px 22px;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
  .recent-updates-heading h2{font-size:17px;letter-spacing:0}.recent-updates-heading p{margin-top:4px;font-size:11px;color:var(--muted)}
  .recent-updates-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 24px;list-style:none;padding:0;margin:0}.recent-updates-list li{min-width:0}
  .recent-update-link{display:inline-flex;align-items:baseline;gap:7px;font-size:13px;font-weight:550;color:var(--accent);line-height:1.6}.recent-update-link:hover{text-decoration:underline}.recent-update-link>span:last-child{font-size:11px;flex-shrink:0}
  .recent-updates-list time{display:block;margin-top:3px;color:var(--muted);font-size:11px}
  @media(max-width:900px){.recent-updates{grid-template-columns:110px minmax(0,1fr);gap:18px}.recent-updates-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.recent-updates{grid-template-columns:1fr;gap:13px;padding:16px 18px}.recent-updates-heading{display:flex;align-items:baseline;gap:12px}.recent-updates-heading p{margin-top:0}.recent-updates-list{gap:13px 20px}}
  .partner-site{display:flex;align-items:center;flex-wrap:wrap;gap:8px 20px;margin-top:22px;padding:12px 18px;border:1px solid #e3deef;border-radius:8px;background:#f2f0f8;font-size:12px}
  .partner-label{color:var(--muted);font-size:11px}
  .partner-site a{color:var(--accent);font-weight:600}
  .partner-site a:hover{text-decoration:underline}
  .partner-description{color:var(--muted);margin-left:auto;font-size:11px}
  @media(max-width:760px){.partner-site{gap:6px 14px;padding:11px 14px;margin-top:16px}.partner-description{flex-basis:100%;margin-left:0}}
  .theme-entry-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .theme-entry{display:flex;flex-direction:column;padding:21px;border:1px solid var(--line);border-top:3px solid var(--area-color);border-radius:9px;background:var(--surface)}
  .theme-entry>span{font-size:10px;color:var(--muted)}.theme-entry h3{font-size:18px;margin:12px 0}.theme-entry p{font-size:13px;line-height:1.8;color:var(--muted);margin-bottom:18px}.theme-entry strong{font-size:12px;font-weight:500;color:var(--accent);margin-top:auto}
  .theme-entry:hover{border-color:#b6a5d8}.additional-entries{display:flex;gap:18px;margin-top:18px}.additional-entries>a{flex:1;padding:18px 21px;background:#f0edf7;border-radius:8px;font-size:16px;font-weight:600}.additional-entries span{display:block;font-size:12px;font-weight:400;color:var(--muted);margin-top:5px}
  @media(max-width:900px){.theme-entry-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.featured-section .section-heading{flex-wrap:wrap;gap:12px}.additional-entries{flex-direction:column}}
  @media(max-width:430px){.theme-entry-grid{grid-template-columns:1fr}}
</style>
