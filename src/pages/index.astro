---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptCard from '../components/ConceptCard.astro';
import NetworkArt from '../components/NetworkArt.astro';
import RandomConceptFigure from '../components/RandomConceptFigure.astro';
import DepthBadge from '../components/DepthBadge.astro';
import FeedbackPanel from '../components/FeedbackPanel.astro';
import { url } from '../lib/paths';
import { learningPaths } from '../data/paths';
import { knowledgeAreas } from '../data/knowledge';
import { getConceptPublicationRanks, compareConceptPublication } from '../lib/concept-publication';
import { comparePersonCoreWork } from '../lib/person-chronology';
const concepts = (await getCollection('concepts')).sort((a,b) => a.data.order - b.data.order);
const bySlug = Object.fromEntries(concepts.map(c => [c.data.slug, c]));
const people = concepts.filter(c=>c.data.kind==='person').sort(comparePersonCoreWork);
const publicationRanks = getConceptPublicationRanks();
const inDepth = concepts.filter(c=>c.data.depth==='in-depth' && c.data.kind!=='person').sort((a,b)=>compareConceptPublication(a,b,publicationRanks));
const featured = inDepth.slice(0,8);
const moreInDepth = inDepth.slice(8);
---
<BaseLayout>
  <div class="container">
    <aside class="partner-site" aria-label="合作网站">
      <span class="partner-label">合作网站</span>
      <a href="https://betterci.github.io/hearing-paper-monitor/" target="_blank" rel="noopener noreferrer">听觉研究论文追踪 <span aria-hidden="true">↗</span></a>
      <span class="partner-description">关注听觉科学的新近研究</span>
    </aside>
    <section class="hero">
      <div>
        <div class="eyebrow">A living knowledge network</div>
        <h1><span class="hero-n">n³</span>Hearingpedia</h1>
        <p class="hero-subtitle">An AI-native Knowledge System for Hearing Science</p>
        <p class="hero-description">从声音到听觉。<br />连接机制、感知与工程，<br />让每一个概念都有迹可循。</p>
        <form class="hero-search" action={url('search')} method="get" role="search">
          <span class="search-symbol" aria-hidden="true">⌕</span>
          <label class="sr-only" for="hero-query">搜索听觉科学词条</label>
          <input id="hero-query" type="search" name="q" placeholder="搜索概念、英文术语或研究方法…" required />
          <button type="submit">搜索 ↗</button>
        </form>
        <div class="hero-actions"><a class="button primary" href={url('explore')}>Explore Concepts <span>↗</span></a><a class="button" href={url('map')}>Explore the Map</a><a class="button" href={url('learn')}>Start Learning</a></div>
        <p class="hero-note">面向学习与研究 · 连接概念、方法与科学证据</p>
      </div>
      <NetworkArt />
    </section>
    <div class="project-strip">
      <div class="strip-intro"><strong>一个概念，一页清晰的解释。</strong>沿着关联，找到理解下一个问题的入口。</div>
      <div class="strip-stats"><span><strong>{concepts.length}</strong>百科词条</span><span><strong>{knowledgeAreas.length}</strong>知识层面</span><span><strong>{learningPaths.length}</strong>学习路径</span></div>
    </div>
    <RandomConceptFigure concepts={inDepth} />
    {inDepth.length>0 && <section class="section featured-section" aria-labelledby="in-depth-title">
      <div class="section-heading"><div><div class="eyebrow">Read in depth</div><h2 id="in-depth-title">从深度词条开始</h2><p>从定义、机制到研究方法，结合文献深入理解听觉科学。</p></div><span class="featured-count">{inDepth.length} 篇深度词条</span></div>
      <div class="concept-grid" id="in-depth-featured">{featured.map(concept=><ConceptCard concept={concept}/>)}</div>
      {moreInDepth.length>0 && <nav id="in-depth-more" class="more-in-depth" aria-label="更多深度词条"><span>继续深入</span><div>{moreInDepth.map(concept=><a href={url(`concepts/${concept.data.slug}`)}>{concept.data.title}<span aria-hidden="true"> ↗</span></a>)}</div></nav>}
    </section>}
    {knowledgeAreas.map(area=><section class="section"><div class="section-heading"><div><div class="eyebrow">{area.english}</div><h2>{area.title}</h2><p>{area.note}</p></div><a class="text-link" href={url('map')}>探索三维关系 ↗</a></div><div class="concept-grid">{concepts.filter(c=>c.data.knowledge_area===area.id && c.data.kind!=='person').sort((a,b)=>Number(b.data.depth==='in-depth')-Number(a.data.depth==='in-depth')||a.data.order-b.data.order).map(concept=><ConceptCard concept={concept}/>)}</div></section>)}
    {people.length>0 && <section class="section" aria-labelledby="people-home-title"><div class="section-heading"><div><div class="eyebrow">People &amp; research history</div><h2 id="people-home-title">听觉研究人物</h2><p>从研究问题、实验和著作出发，回顾语音与听觉研究的发展。</p></div><a class="text-link" href={url('people')}>认识研究者 ↗</a></div><div class="concept-grid">{people.map(concept=><ConceptCard concept={concept}/>)}</div></section>}
    <section class="section">
      <div class="section-heading"><div><div class="eyebrow">Follow the connections</div><h2>把概念连成一条路径</h2><p>先补齐前置知识，再进入研究问题。</p></div><a class="text-link" href={url('learn')}>进入学习路径 ↗</a></div>
      <div class="path-grid">{learningPaths.map(path => <div class="path-card"><div class="eyebrow">{path.english}</div><h3>{path.title}</h3><p>{path.description}</p><div class="path-chips">{path.slugs.map((slug,i) => <>{i>0 && <span aria-hidden="true">→</span>}<a href={url(`concepts/${slug}`)}>{bySlug[slug].data.title}</a></>)}</div></div>)}</div>
    </section>
    <section class="section"><div class="note-panel"><div><h3>有来源，也有状态。</h3><p><DepthBadge depth="standard" /> 系统介绍核心定义、机制和应用；<DepthBadge /> 提供更完整的研究证据、模型与专题讨论。专业审阅进度在各词条中单独标注；每次更新保留引用和变更记录。</p></div><a class="text-link" href={url('contribute')}>了解贡献流程 ↗</a></div></section>
    <FeedbackPanel />
  </div>
</BaseLayout>
<style>
  .partner-site{display:flex;align-items:center;flex-wrap:wrap;gap:8px 20px;margin-top:22px;padding:12px 18px;border:1px solid #e3deef;border-radius:8px;background:#f2f0f8;font-size:12px}
  .partner-label{color:var(--muted);font-size:11px}
  .partner-site a{color:var(--accent);font-weight:600}
  .partner-site a:hover{text-decoration:underline}
  .partner-description{color:var(--muted);margin-left:auto;font-size:11px}
  @media(max-width:760px){.partner-site{gap:6px 14px;padding:11px 14px;margin-top:16px}.partner-description{flex-basis:100%;margin-left:0}}
  .featured-count{color:#216658;white-space:nowrap;font-size:12px;padding-bottom:3px}
  .more-in-depth{display:flex;gap:20px;margin-top:20px;padding:18px 0;border-bottom:1px solid var(--line);font-size:12px;line-height:1.8}
  .more-in-depth>span{color:var(--muted);white-space:nowrap}
  .more-in-depth>div{display:flex;flex-wrap:wrap;gap:10px 22px}
  .more-in-depth a{color:#216658}
  .more-in-depth a:hover{text-decoration:underline}
  @media(max-width:760px){.featured-section .section-heading{flex-wrap:wrap;gap:12px}.more-in-depth{flex-direction:column;gap:10px}}
</style>
