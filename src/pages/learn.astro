---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroPathCards from '../components/IntroPathCards.astro';
import { introductoryPaths, learningPaths } from '../data/paths';
import { url, asset } from '../lib/paths';
const bySlug = Object.fromEntries((await getCollection('concepts')).map(c=>[c.data.slug,c]));
const foundationPaths = learningPaths.filter(path=>path.slugs.some(slug=>bySlug[slug]?.data.kind==='course'));
const mainPaths = learningPaths.filter(path=>!foundationPaths.includes(path));
const foundationEntries = foundationPaths.flatMap(path=>path.slugs.filter(slug=>bySlug[slug]?.data.kind==='course').map(slug=>({concept:bySlug[slug],anchor:path.id})));
const courseDescriptions: Record<string,string> = {
  'linear-algebra':'从向量与基到矩阵、投影和特征分解，用声音例子理解线性关系。',
  'probability-theory':'从随机变量与分布到贝叶斯和极限定理，理解听觉检测与噪声中的随机性。',
  'complex-analysis':'从复数与解析性到复积分、级数和留数，理解相位、零极点与变换。',
  'information-theory':'从熵与互信息到编码、容量和率失真，理解不确定性与信息传输。',
  'chinese-phonetics':'从声母、韵母和声调到连读与韵律，连接汉语发音、声学与听觉。',
  'mathematical-statistics':'从抽样与估计到区间、检验和回归，理解听觉研究的效应与不确定性。',
  'computational-neuroscience':'从膜电位与脉冲到编码、网络和学习，理解神经模型怎样计算与接受检验。',
  'machine-learning':'从损失与回归到分类、降维和神经网络，理解预测、泛化与可靠验证。',
  'circuit-theory':'从电压、电流与守恒到暂态、阻抗和反馈，理解电路响应及音频接口。',
  'mathematical-physics-methods':'从场与定解条件到模态、特殊函数和格林函数，理解物理方程怎样求解。',
  'functional-analysis':'从空间、收敛与投影到对偶和算子，理解无限维问题的可解性与稳定性。',
  'biophysics':'配合计算神经科学，从能量、扩散与电化学理解膜、通道和听觉转导。',
  'signals-and-systems':'从信号与系统性质到卷积、变换和采样，理解声音怎样经过通路而改变。',
};
const stepUrl = (slug: string, path: string) => url(`concepts/${slug}`) + '?path=' + encodeURIComponent(path);
---
<BaseLayout title="Learn · 学习路径">
  <div class="container">
    <div class="page-intro"><div class="eyebrow">Learn together</div><h1>顺着一个问题，逐步深入。</h1><p>从 4 步入门路线开始，先读导言和指定章节；需要完整知识背景时，再选择深入路线。</p></div>
    <section class="section" aria-label="选择入门路线"><IntroPathCards /></section>
    <section class="section" aria-labelledby="introductory-title">
      <div class="section-heading"><div><div class="eyebrow">Read with a purpose</div><h2 id="introductory-title">入门路线：每一步都有目标</h2><p>指定章节提供阅读重点，选读内容帮助你按当前问题继续深入。</p></div></div>
      {introductoryPaths.map(path=><article class="path-full intro-path-full" id={path.id}>
        <div class="eyebrow">{path.english}</div><h2>{path.title}</h2><p>{path.description}</p>
        <dl class="path-objectives"><div><dt>学习目标</dt><dd>{path.goal}</dd></div><div><dt>阅读准备</dt><dd>{path.prerequisite}</dd></div></dl>
        <ol class="path-steps">{path.steps.map((step,i)=><li><a href={stepUrl(step.slug,path.id)}><span class="step-index">{String(i+1).padStart(2,'0')}</span><span><strong>{bySlug[step.slug].data.title}</strong><small>{step.goal}</small><small class="reading-focus">先读导言，再读「{step.sections.join('」「')}」。</small></span><span class="step-arrow" aria-hidden="true">↗</span></a></li>)}</ol>
        <div class="optional-reading"><strong>按需选读</strong>{path.optional.map(slug=><a href={url('concepts/'+slug)}>{bySlug[slug].data.title} ↗</a>)}</div>
        <a class="text-link" href={'#'+path.furtherPath}>进入完整路线：{learningPaths.find(item=>item.id===path.furtherPath)?.title} →</a>
      </article>)}
    </section>
    <section class="section" aria-labelledby="full-paths-title">
      <div class="section-heading"><div><div class="eyebrow">Go further</div><h2 id="full-paths-title">完整路线 · {mainPaths.length} 条</h2><p>展开一条路线查看全部词条。可以顺序阅读，也可以从论文中遇到的概念开始。</p></div></div>
      {mainPaths.map(path=><details class="path-full full-path-details" id={path.id}><summary><span>{path.title}</span><small>{path.slugs.length} 步</small></summary><div class="full-path-body"><p>{path.description}</p><ol class="path-steps">{path.slugs.map((slug,i)=><li><a href={stepUrl(slug,path.id)}><span class="step-index">{String(i+1).padStart(2,'0')}</span><span><strong>{bySlug[slug].data.title}</strong><small>{bySlug[slug].data.english} · {bySlug[slug].data.summary}</small></span><span class="step-arrow" aria-hidden="true">↗</span></a></li>)}</ol></div></details>)}
    </section>
    {foundationPaths.length>0 && <section class="section foundations-section" id="foundations" aria-labelledby="foundations-title">
      <div class="eyebrow">Supplementary learning</div><h2 id="foundations-title">补充学习：基础课程</h2><p>补足听觉研究中常用的基础知识，从一门课开始阅读。每篇开头说明起步知识、随用随补的小例子和分层读法，相关课程供按需查阅。</p>
      <div class="foundation-grid">
        {foundationEntries.map(({concept,anchor})=><a class="foundation-card" id={anchor} href={url('concepts/'+concept.data.slug)}>
          <img class="foundation-sketch" src={asset('figures/foundation-courses/'+concept.data.slug+'.svg')} alt="" width="320" height="180" loading="lazy" />
          <div class="foundation-copy"><span class="foundation-label">基础课程 · 深度讲解</span><h3>{concept.data.title}</h3><p class="foundation-english">{concept.data.english}</p><p class="foundation-description">{courseDescriptions[concept.data.slug] || concept.data.summary}</p><span class="foundation-read">阅读词条 <span aria-hidden="true">↗</span></span></div>
        </a>)}
      </div>
    </section>}
  </div>
</BaseLayout>
<script>
  const revealPath = () => {
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const route = document.getElementById(id);
    if (route instanceof HTMLDetailsElement) route.open = true;
  };
  revealPath();
  window.addEventListener('hashchange', revealPath);
</script>
<style>
  .foundations-section{border-top:1px solid var(--line);padding-top:32px;scroll-margin-top:100px}.foundations-section>h2{font-size:20px;margin:12px 0 8px}.foundations-section>p{font-size:13px;color:var(--muted);line-height:1.8}
  .foundation-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:26px}.foundation-card{display:flex;flex-direction:column;min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden;scroll-margin-top:100px;transition:border-color .15s,box-shadow .15s}.foundation-card:hover{border-color:#b5a6d2;box-shadow:0 6px 20px #39315108}.foundation-card:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.foundation-sketch{display:block;width:100%;height:auto;aspect-ratio:16/9;background:#f3f1f8}.foundation-copy{padding:22px 24px;display:flex;flex-direction:column;flex:1}.foundation-label{font-size:10px;color:var(--muted);letter-spacing:.04em}.foundation-copy h3{font-size:22px;margin:10px 0 3px}.foundation-english{font-size:11px;color:var(--muted);margin:0}.foundation-description{font-size:13px;line-height:1.85;color:var(--muted);margin:17px 0 20px}.foundation-read{display:flex;justify-content:space-between;gap:16px;margin-top:auto;font-size:12px;color:var(--accent)}
  .path-objectives{margin:22px 0;font-size:14px;line-height:1.85}.path-objectives>div{display:grid;grid-template-columns:80px 1fr;gap:12px;margin:10px 0}.path-objectives dt{font-weight:600}.path-objectives dd{margin:0;color:var(--muted)}
  .reading-focus{color:var(--accent)}.optional-reading{display:flex;gap:10px 20px;flex-wrap:wrap;margin:22px 0;font-size:13px}.optional-reading a{color:var(--accent)}
  .full-path-details{padding:0;overflow:hidden}.full-path-details summary{display:flex;align-items:baseline;justify-content:space-between;gap:18px;padding:24px 28px;cursor:pointer;font-size:20px;font-weight:600;list-style:none}.full-path-details summary::before{content:'＋';color:var(--accent)}.full-path-details[open] summary::before{content:'−'}.full-path-details summary span{flex:1}.full-path-details summary small{font-size:12px;white-space:nowrap;color:var(--muted);font-weight:400}.full-path-body{padding:0 28px 24px}
  @media(min-width:761px) and (max-width:1050px){.foundation-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.foundation-grid{grid-template-columns:1fr;gap:18px}.foundation-card{display:grid;grid-template-columns:120px minmax(0,1fr);align-items:center}.foundation-sketch{aspect-ratio:auto;height:100%;object-fit:contain}.foundation-copy{padding:20px 18px}.foundation-copy h3{font-size:20px}.foundation-description{font-size:12px;margin:12px 0 16px}.path-objectives>div{grid-template-columns:1fr;gap:3px}.full-path-details summary{padding:20px;font-size:18px}.full-path-body{padding:0 20px 20px}}
</style>
