---
import { getCollection } from 'astro:content';
import '../styles/atlas-labels.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
import { knowledgeAreas, kindLabels } from '../data/knowledge';
import { knowledgeRelations, relationTypes } from '../data/relations';
const concepts=(await getCollection('concepts')).sort((a,b)=>a.data.order-b.data.order);
const bySlug=Object.fromEntries(concepts.map(c=>[c.data.slug,c]));
const payload={nodes:concepts.map(c=>({id:c.data.slug,title:c.data.title,english:c.data.english,aliases:c.data.aliases,summary:c.data.summary,kind:kindLabels[c.data.kind],area:c.data.knowledge_area,url:url('concepts/'+c.data.slug)})),edges:knowledgeRelations,areas:knowledgeAreas,types:relationTypes};
---
<BaseLayout title="Map · 三维知识地图"><div class="container">
  <div class="page-intro map-intro"><div><div class="eyebrow">An atlas of hearing science</div><h1>知识，在连接中展开。</h1><p>旋转三维网络，穿行于声音、感知与技术之间。选择一个概念，查看它属于什么、描述什么，又怎样被研究。</p></div><div class="atlas-count"><strong>{concepts.length}</strong><span>概念</span><strong>{knowledgeRelations.length}</strong><span>知识关联</span></div></div>
  <section class="atlas" aria-label="三维听觉科学知识网络">
    <div class="atlas-toolbar">
      <div class="atlas-search"><span aria-hidden="true">⌕</span><label class="sr-only" for="atlas-query">定位地图中的词条</label><input id="atlas-query" list="atlas-suggestions" placeholder="定位概念 / English / 缩写" autocomplete="off" /><datalist id="atlas-suggestions">{concepts.map(c=><option value={c.data.title}>{c.data.english} {c.data.aliases.join(' ')}</option>)}</datalist><button id="atlas-find" type="button">定位</button></div>
      <label class="atlas-filter"><span>知识层面</span><select id="atlas-area"><option value="">全部层面</option>{knowledgeAreas.map(a=><option value={a.id}>{a.title}</option>)}</select></label>
      <label class="atlas-filter"><span>关系类型</span><select id="atlas-relation"><option value="">全部关系</option>{Object.entries(relationTypes).map(([id,t])=><option value={id}>{t.label}</option>)}</select></label>
    </div>
    <div class="atlas-main">
      <div class="atlas-stage" id="atlas-stage" data-state="loading">
        <div class="atlas-stage-heading"><span class="atlas-live-dot" aria-hidden="true"></span><span>HEARING SCIENCE / 3D ATLAS</span></div>
        <div id="atlas-canvas-host" class="atlas-canvas-host"></div>
        <div id="atlas-labels" class="atlas-labels"></div>
        <p id="atlas-status" class="atlas-status" role="status">正在加载三维网络…</p>
        <div class="atlas-camera-controls" aria-label="地图视角操作"><button type="button" id="atlas-rotate-left" aria-label="向左旋转地图">↶</button><button type="button" id="atlas-zoom-in" aria-label="放大地图">＋</button><button type="button" id="atlas-zoom-out" aria-label="缩小地图">−</button><button type="button" id="atlas-reset">全景</button><button type="button" id="atlas-motion" aria-pressed="true">暂停动效</button><button type="button" id="atlas-label-toggle" aria-pressed="true">标签</button></div>
        <p class="atlas-gesture">拖动旋转 · 滚轮缩放 · 触屏双指缩放</p>
      </div>
      <aside class="atlas-detail" aria-label="所选概念详情">
        <div class="detail-eyebrow" id="atlas-detail-area">从一个概念开始</div>
        <h2 id="atlas-detail-title">探索听觉科学</h2>
        <p class="detail-english" id="atlas-detail-english">Sound → Perception → Technology</p>
        <span class="detail-kind" id="atlas-detail-kind">六个知识层面</span>
        <p id="atlas-detail-summary">点击发光节点或使用上方搜索。网络按知识层面布局，关联区分类型、表征、机制、测量、分析与应用。</p>
        <a id="atlas-detail-link" class="atlas-read" href={url('explore')}>浏览百科词条 ↗</a>
        <div class="detail-relations-heading"><h3>相邻概念</h3><span id="atlas-neighbor-count">—</span></div>
        <ul id="atlas-neighbors" class="atlas-neighbors"><li class="atlas-empty">选中节点后，在这里逐条查看关系。</li></ul>
        <button id="atlas-clear" type="button" class="atlas-clear" hidden>清除选择，返回全网</button>
      </aside>
    </div>
    <div class="atlas-legend">{knowledgeAreas.map(a=><button type="button" data-area-chip={a.id} style={'--area-color:'+a.color} aria-pressed="false"><i aria-hidden="true"></i>{a.title}</button>)}</div>
  </section>
  <p class="map-caption">颜色表示知识层面；节点位置与动效用于导航，不表示解剖位置、因果方向、证据强弱或真实信号流。</p>
  <section class="section"><div class="section-heading"><div><div class="eyebrow">Browse the knowledge system</div><h2>六个层面，通向同一知识网络</h2><p>物理量、感知现象、测试指标与研究方法分别归类，跨领域联系保留在网络中。</p></div></div><div class="atlas-directory">{knowledgeAreas.map(a=><article style={'--area-color:'+a.color}><h3>{a.title}</h3><p>{a.note}</p><ul>{concepts.filter(c=>c.data.knowledge_area===a.id).map(c=><li><a href={url('concepts/'+c.data.slug)}>{c.data.title}<small>{kindLabels[c.data.kind]}</small></a></li>)}</ul></article>)}</div></section>
  <details class="map-relations"><summary>查看全部 {knowledgeRelations.length} 条关联及其定义</summary><p>类型关系有方向；机制与概念联系只说明知识关联，不能据此推导因果或强度。学习顺序由独立学习路径提供。</p><ul>{knowledgeRelations.map(r=><li><a href={url('concepts/'+r.source)}>{bySlug[r.source].data.title}</a> {relationTypes[r.type].directional?'→':'↔'} <a href={url('concepts/'+r.target)}>{bySlug[r.target].data.title}</a><strong>{relationTypes[r.type].label}</strong><span>{r.note}</span></li>)}</ul></details>
  <script id="atlas-data" type="application/json" set:html={JSON.stringify(payload).replaceAll('<','\u003c')} />
</div></BaseLayout>
<script>
  import { initKnowledgeMap } from '../scripts/knowledge-map';
  initKnowledgeMap();
</script>
<style>
.map-intro{display:flex;align-items:center;justify-content:space-between;gap:32px}.map-intro p{max-width:730px}.atlas-count{display:grid;grid-template-columns:auto auto;align-items:baseline;gap:3px 14px;white-space:nowrap}.atlas-count strong{font-size:31px;font-weight:500;color:var(--accent)}.atlas-count span{font-size:12px;color:var(--muted)}.atlas{border:1px solid #243a58;border-radius:18px;overflow:hidden;background:#091325;color:#e4edf9;box-shadow:0 20px 70px #20385b22}.atlas-toolbar{display:flex;gap:16px;align-items:center;padding:17px 22px;border-bottom:1px solid #ffffff14;background:#0e1b30;flex-wrap:wrap}.atlas-search{display:flex;gap:9px;align-items:center;background:#17253d;border:1px solid #ffffff17;border-radius:8px;padding:7px 10px;flex:1;min-width:220px}.atlas-search>span{color:#91c8e4;font-size:23px}.atlas-search input{width:100%;min-width:0;background:none;border:0;color:#eef5ff;font:inherit;font-size:12px;outline-offset:3px}.atlas-search input::placeholder{color:#849ab8}.atlas-search button{background:#253f5c;color:#c4e4f5;border:0;border-radius:5px;font-size:11px;padding:6px 10px;white-space:nowrap;cursor:pointer}.atlas-filter{display:flex;gap:9px;align-items:center;font-size:11px;color:#9cafc8}.atlas-filter select{max-width:150px;background:#17253d;color:#d5e4f6;border:1px solid #ffffff18;padding:8px;border-radius:6px;font-size:11px}.atlas-main{display:grid;grid-template-columns:minmax(0,1fr) 290px}.atlas-stage{position:relative;height:660px;overflow:hidden;background:radial-gradient(ellipse at 45% 48%,#152b49 0%,#0a172a 46%,#070e1d 100%)}.atlas-canvas-host,.atlas-labels{position:absolute;inset:0}.atlas-labels{pointer-events:none}.atlas-stage-heading{position:absolute;z-index:3;top:21px;left:22px;font-size:10px;letter-spacing:.12em;color:#8ba6c7;display:flex;gap:9px;align-items:center;pointer-events:none}.atlas-live-dot{width:5px;height:5px;background:#78d9e7;border-radius:50%;box-shadow:0 0 12px #62d8ff}.atlas-status{position:absolute;bottom:66px;left:22px;right:20px;font-size:11px;color:#9eb6d1;pointer-events:none;margin:0}.atlas-camera-controls{position:absolute;z-index:5;bottom:25px;left:20px;display:flex;gap:5px;flex-wrap:wrap}.atlas-camera-controls button{background:#172c43cf;border:1px solid #6286aa40;color:#d5e6f8;border-radius:6px;padding:7px 11px;font-size:11px;cursor:pointer;backdrop-filter:blur(10px)}.atlas-camera-controls button:hover{background:#29475d}.atlas-camera-controls button:focus-visible,.atlas-legend button:focus-visible{outline:2px solid #b2e7fa;outline-offset:3px}.atlas-gesture{position:absolute;bottom:8px;left:22px;font-size:9px;color:#677f9b;margin:0;pointer-events:none}.atlas-detail{padding:26px 23px;background:linear-gradient(145deg,#122239,#0b1729);border-left:1px solid #ffffff12;min-width:0}.detail-eyebrow{color:#9dd6eb;font-size:10px;letter-spacing:.08em;margin-bottom:19px}.atlas-detail h2{font-size:23px;line-height:1.45;margin:0 0 8px;color:#f3f7fd}.detail-english{font-size:11px;line-height:1.7;color:#95a9c2;margin:0 0 12px}.detail-kind{display:inline-block;color:#9faec2;background:#ffffff09;border:1px solid #ffffff10;border-radius:5px;padding:4px 8px;font-size:10px}.atlas-detail #atlas-detail-summary{font-size:12px;line-height:1.95;color:#b7c7db;margin:18px 0}.atlas-read{display:block;padding:11px 14px;background:#315b75;border:1px solid #5690ac66;border-radius:7px;font-size:12px;color:#e2f2fc}.detail-relations-heading{display:flex;justify-content:space-between;align-items:center;margin-top:24px}.detail-relations-heading h3{font-size:12px;font-weight:500;margin:0}.detail-relations-heading span{font-size:11px;color:#96b3cf}.atlas-neighbors{padding:0;margin:12px 0;list-style:none;max-height:310px;overflow:auto;scrollbar-width:thin;scrollbar-color:#34516b transparent}.atlas-empty{font-size:11px;line-height:1.8;color:#7f96b3}.atlas-clear{font-size:10px;color:#97c8dd;background:none;border:0;padding:8px 0;cursor:pointer}.atlas-legend{display:flex;flex-wrap:wrap;gap:12px 21px;padding:18px 23px;border-top:1px solid #ffffff10;background:#0e1b2c}.atlas-legend button{display:flex;gap:8px;align-items:center;background:none;border:0;color:#b6c5da;font-size:11px;cursor:pointer;padding:0}.atlas-legend i{width:6px;height:6px;border-radius:50%;background:var(--area-color);box-shadow:0 0 10px var(--area-color)}.atlas-legend button[aria-pressed=true]{color:white;text-decoration:underline;text-underline-offset:5px}.atlas-directory{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.atlas-directory article{padding:24px;border:1px solid var(--line);border-top:3px solid var(--area-color);border-radius:8px;background:#fff}.atlas-directory h3{margin:0 0 10px;font-size:18px}.atlas-directory p{font-size:12px;line-height:1.8;color:var(--muted);min-height:42px}.atlas-directory ul{list-style:none;padding:0;margin:17px 0 0}.atlas-directory li{padding:9px 0;border-top:1px solid var(--line);font-size:13px}.atlas-directory small{display:block;font-size:10px;color:var(--muted);margin-top:4px}.map-relations{font-size:12px;background:white;border:1px solid var(--line);border-radius:8px;padding:20px;margin-bottom:50px}.map-relations summary{cursor:pointer;color:var(--accent)}.map-relations p{color:var(--muted);line-height:1.8}.map-relations ul{padding-left:18px}.map-relations li{margin:14px 0;line-height:1.8}.map-relations a{color:var(--accent)}.map-relations strong{font-weight:500;font-size:10px;padding:3px 7px;background:#eef2f8;border-radius:4px;margin-left:9px}.map-relations li>span{display:block;color:var(--muted);font-size:11px}
@media(max-width:1000px){.atlas-main{grid-template-columns:minmax(0,1fr) 250px}.atlas-stage{height:620px}.atlas-detail{padding:23px 18px}.atlas-directory{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.map-intro{display:block}.atlas-count{display:flex;gap:8px;margin:20px 0}.atlas-count strong{font-size:23px}.atlas-count span{margin-right:18px}.atlas-toolbar{padding:14px;gap:10px}.atlas-search{flex-basis:100%}.atlas-filter{font-size:10px}.atlas-filter select{max-width:115px}.atlas-main{grid-template-columns:1fr}.atlas-stage{height:490px}.atlas-stage-heading{font-size:8px;left:15px;top:16px}.atlas-detail{border-left:0;border-top:1px solid #ffffff14;padding:22px}.atlas-neighbors{max-height:210px}.atlas-legend{gap:15px;padding:18px}.atlas-legend button{font-size:10px}.atlas-directory{grid-template-columns:1fr}.atlas-camera-controls{left:12px;bottom:26px;gap:4px}.atlas-camera-controls button{padding:6px 8px;font-size:10px}.atlas-status{left:15px;bottom:66px;font-size:10px}.atlas-gesture{left:15px}}
</style>
