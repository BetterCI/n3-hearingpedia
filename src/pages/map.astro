---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { domains, relationLabels } from '../data/domains';
import { url } from '../lib/paths';
const concepts=(await getCollection('concepts')).sort((a,b)=>a.data.order-b.data.order);
const positions: Record<string,{x:number,y:number}> = Object.fromEntries(concepts.map((c,i)=>[c.data.slug,{x:40+(i%4)*250,y:45+Math.floor(i/4)*150}]));
const mapHeight=90+Math.ceil(concepts.length/4)*150;
const bySlug=Object.fromEntries(concepts.map(c=>[c.data.slug,c]));
const drawn=new Set<string>();
const edges=concepts.flatMap(c=>c.data.related.map(r=>({from:c.data.slug,to:r.slug,relation:r.relation}))).filter(edge=>{const key=[edge.from,edge.to].sort().join(':');if(drawn.has(key))return false;drawn.add(key);return true;});
function wrap(text:string,size:number){const chars=Array.from(text);return Array.from({length:Math.ceil(chars.length/size)},(_,i)=>chars.slice(i*size,(i+1)*size).join(''));}
---
<BaseLayout title="Map · 知识地图"><div class="container"><div class="page-intro"><div class="eyebrow">Knowledge map</div><h1>理解，发生在连接之间。</h1><p>这张地图连接已有概念。线条来自词条的关联记录；点击节点进入解释，前置知识与应用关系可在词条末尾查看。</p></div>
  <section class="section"><div class="map-legend"><span><i></i>机制与相关概念</span><span><i class="engineering"></i>方法与应用连接</span><span>{concepts.length} 个节点 · {edges.length} 条关联</span></div>
    <div class="map-controls"><label for="map-domain">突出显示领域</label><select id="map-domain"><option value="">全部领域</option>{domains.filter(d=>concepts.some(c=>c.data.categories.includes(d.id))).map(d=><option value={d.id}>{d.zh}</option>)}</select><span>所有概念仍可点击；手机上使用下方文字入口。</span></div>
    <svg class="concept-map" viewBox={'0 0 1050 '+mapHeight} role="img" aria-labelledby="map-title map-desc"><title id="map-title">听觉科学概念的关联地图</title><desc id="map-desc">{concepts.map(c=>c.data.title).join('、')}。每个节点均可点击，下方也提供文字入口。</desc>
      {edges.map(edge=>{const a=positions[edge.from],b=positions[edge.to];const cats=[...bySlug[edge.from].data.categories,...bySlug[edge.to].data.categories];return <path data-map-domains={cats.join(' ')} class:list={['edge',{'edge-method':['method','application'].includes(edge.relation)}]} d={'M '+(a.x+105)+' '+(a.y+55)+' C '+(a.x+105)+' '+((a.y+b.y)/2+55)+', '+(b.x+105)+' '+((a.y+b.y)/2+55)+', '+(b.x+105)+' '+(b.y+55)} />})}
      {concepts.map(c=>{const p=positions[c.data.slug];const zh=wrap(c.data.title,11),en=wrap(c.data.english,32);return <a class="node-group" data-map-domains={c.data.categories.join(' ')} href={url('concepts/'+c.data.slug)} aria-label={c.data.title+'，进入词条'}><title>{c.data.title+' · '+c.data.english}</title><g transform={'translate('+p.x+','+p.y+')'}><rect class="node-bg" width="210" height="112" rx="11"/><text class="map-number" x="17" y="20">{String(c.data.order).padStart(2,'0')}</text><text class="map-zh">{zh.map((line,i)=><tspan x="17" y={43+i*19}>{line}</tspan>)}</text><text class="map-en">{en.map((line,i)=><tspan x="17" y={82+i*14}>{line}</tspan>)}</text></g></a>})}
    </svg>
    <p class="map-caption">关联用于辅助导航，不表示因果关系、证据强度或严格的先后层级。</p>
    <div class="map-mobile-list">{concepts.map(c=><a class="related-link" data-map-domains={c.data.categories.join(' ')} href={url('concepts/'+c.data.slug)}><strong>{c.data.title}</strong><span>↗</span></a>)}</div>
    <details class="map-relations"><summary>查看全部关联及关系类型</summary><ul>{concepts.flatMap(c=>c.data.related.map(r=><li><a href={url('concepts/'+c.data.slug)}>{c.data.title}</a> → <a href={url('concepts/'+r.slug)}>{bySlug[r.slug]?.data.title}</a>：{relationLabels[r.relation]}</li>))}</ul></details>
  </section>
  <section class="section"><div class="section-heading"><div><div class="eyebrow">The wider framework</div><h2>12 个领域，一个知识框架</h2><p>领域分类与词条网络互补；未覆盖的领域仍显示实际收录数量。</p></div></div><div class="domain-grid">{domains.map(d=><a class="domain-card" href={url('domains/'+d.id)}><span class="symbol" aria-hidden="true">{d.symbol}</span><h2>{d.zh}</h2><span class="en-label">{d.name}</span><p>{d.note}</p><span class="domain-count">{concepts.filter(c=>c.data.categories.includes(d.id)).length} 个已有词条 ↗</span></a>)}</div></section>
</div></BaseLayout>
<script>
const domainSelect=document.querySelector<HTMLSelectElement>('#map-domain');
domainSelect?.addEventListener('change',()=>{
  const domain=domainSelect.value;
  document.querySelectorAll<HTMLElement | SVGElement>('[data-map-domains]').forEach(el=>{
    el.classList.toggle('is-muted',!!domain && !el.getAttribute('data-map-domains')?.split(' ').includes(domain));
  });
});
</script>
<style>
.map-controls{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;font-size:12px;color:var(--muted)}
.map-controls select{background:#fff;border:1px solid var(--line);border-radius:7px;padding:8px;color:var(--ink)}
.map-controls span{font-size:11px}
.is-muted{opacity:.2}
.map-relations{font-size:12px;color:var(--muted);background:#fff;border:1px solid var(--line);border-radius:8px;padding:15px 20px}
.map-relations summary{cursor:pointer;color:var(--accent)}
.map-relations ul{padding-left:18px;line-height:2.2}
.map-relations a{color:var(--accent)}
@media(max-width:760px){.concept-map{display:none}}
@media(max-width:430px){.map-mobile-list{grid-template-columns:1fr}}
</style>
