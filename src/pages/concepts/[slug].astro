---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { references, accessLabels } from '../../data/references';
import { domainById, relationLabels } from '../../data/domains';
import { url } from '../../lib/paths';
export async function getStaticPaths() {
  return (await getCollection('concepts')).map(concept=>({params:{slug:concept.data.slug},props:{concept}}));
}
interface Props { concept: CollectionEntry<'concepts'>; }
const { concept } = Astro.props;
const { data } = concept;
const { Content, headings } = await render(concept);
const all = (await getCollection('concepts')).sort((a,b)=>a.data.order-b.data.order);
const bySlug = Object.fromEntries(all.map(c=>[c.data.slug,c]));
const current = all.findIndex(c=>c.data.slug===data.slug);
const prev = all[current-1], next = all[current+1];
const statusLabels = {draft:'Draft · 待审阅',reviewed:'Reviewed · 已审阅',stable:'Stable · 稳定', 'needs-update':'Needs Update · 待更新'};
for (const id of data.references) { if (!references[id]) throw new Error(`Unknown reference ${id} in ${data.slug}`); }
for (const item of data.related) { if (!bySlug[item.slug]) throw new Error(`Unknown related concept ${item.slug} in ${data.slug}`); }
if (['reviewed','stable'].includes(data.status) && (!data.reviewer || !data.reviewed_at)) throw new Error(`Review record missing in ${data.slug}`);
---
<BaseLayout title={`${data.title} · ${data.english}`} description={data.summary}>
  <div class="container">
    <div class="breadcrumb"><a href={url('explore')}>Explore</a><span>/</span><a href={url(`domains/${data.categories[0]}`)}>{domainById[data.categories[0]].zh}</a><span>/</span><span>{data.title}</span></div>
    <div class="article-shell">
      <article data-pagefind-body>
        <header class="article-header">
          <span class:list={['status-pill',data.status]}>{statusLabels[data.status]}</span>
          <h1 data-pagefind-meta="title">{data.title}</h1>
          <p class="article-english" data-pagefind-weight="5">{data.english}</p>
          <p class="lead">{data.summary}</p>
          <span class="sr-only" data-pagefind-weight="15">{data.aliases.join(' ')}</span>
          <span class="sr-only" data-pagefind-weight="3">{data.tags.join(' ')}</span>
          <div class="article-metadata"><span>更新 {data.last_updated.replaceAll('-','.')}</span><span>{data.authors.join(' / ') || '作者待登记'}</span><span>{data.reviewer ? `审阅：${data.reviewer} · ${data.reviewed_at}` : '尚未经过成员科学审阅'}</span></div>
          <div class="article-tags">{data.categories.map(id=><span data-pagefind-filter={`领域:${domainById[id].zh}`}>{domainById[id].zh}</span>)}{data.tags.map(tag=><span>{tag}</span>)}</div>
        </header>
        {data.status==='draft' && <div class="draft-notice" data-pagefind-ignore>这是一篇 AI 辅助初稿，供组内学习与讨论。文献来源和核验范围列于文末，具体科学表述仍待成员审阅。本文未声称覆盖截至今日的全部研究。</div>}
        <div class="prose"><Content /></div>
        <section class="references" id="references" data-pagefind-ignore>
          <h2>参考文献与证据范围</h2>
          <ol class="reference-list">{data.references.map(id=>{const ref=references[id];return <li id={`ref-${id}`}><a class="reference-title" href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title} ↗</a><p class="reference-detail">{ref.publicationType==='preprint' && <strong class="preprint-label">预印本 · 未同行评审 · </strong>}{ref.authors} ({ref.year}). {ref.publication}.</p><div class="reference-links">{ref.doi && <a href={`https://doi.org/${ref.doi}`} target="_blank" rel="noopener noreferrer">DOI: {ref.doi}</a>}<a href={ref.url} target="_blank" rel="noopener noreferrer">{accessLabels[ref.access]} ↗</a></div><p class="source-scope">引用用途：{ref.supports}</p></li>})}</ol>
        </section>
        <section class="related-section" id="related" data-pagefind-ignore><h2>关联概念</h2><div class="related-list">{data.related.map(item=><a class="related-link" href={url(`concepts/${item.slug}`)}><div><strong>{bySlug[item.slug].data.title}</strong><span>{bySlug[item.slug].data.english} · {relationLabels[item.relation]}</span></div><span aria-hidden="true">↗</span></a>)}</div></section>
        <nav class="article-next" aria-label="按词条目录继续阅读" data-pagefind-ignore>{prev ? <a href={url(`concepts/${prev.data.slug}`)}>← {prev.data.title}</a> : <a href={url('learn')}>← 学习路径</a>}{next ? <a href={url(`concepts/${next.data.slug}`)}>{next.data.title} →</a> : <a href={url('learn')}>返回学习路径 →</a>}</nav>
      </article>
      <aside class="article-sidebar" aria-label="词条目录"><div class="toc-label">ON THIS PAGE / 本页导航</div><nav>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#references">参考文献与证据范围</a><a href="#related">关联概念</a></nav><div class="sidebar-info">面向课题组成员<br />理解概念 → 阅读文献 → 提出问题<br /><a class="text-link" href={url('contribute')}>参与审阅 ↗</a></div></aside>
    </div>
  </div>
</BaseLayout>
