---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DepthBadge from '../../components/DepthBadge.astro';
import FeedbackPanel from '../../components/FeedbackPanel.astro';
import { references, accessLabels } from '../../data/references';
import { domainById } from '../../data/domains';
import { knowledgeAreaById, kindLabels } from '../../data/knowledge';
import { relationshipsFor } from '../../data/relations';
import { mergedConceptRedirects, type MergedConceptRedirect } from '../../data/merged-concepts';
import { url, asset } from '../../lib/paths';
/**
 * Generate canonical articles and redirects for retired article URLs.
 * Inputs: none. Returns Astro path/props records; reads the concept collection.
 * Collection loading errors propagate to the build. Retired routes are not indexed.
 * Usage: Astro calls getStaticPaths during the static site build.
 */
export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return [
    ...concepts.map(concept=>({params:{slug:concept.data.slug},props:{concept}})),
    ...mergedConceptRedirects.map(redirect=>({params:{slug:redirect.slug},props:{redirect}})),
  ];
}
/** Route props contain either a canonical concept or a historical redirect record. */
interface Props { concept?: CollectionEntry<'concepts'>; redirect?: MergedConceptRedirect; }
const { concept, redirect } = Astro.props;
if (redirect) return Astro.redirect(url(`concepts/${redirect.target}`)+`#${redirect.anchor}`, 301);
if (!concept) throw new Error(`Missing concept for ${Astro.params.slug}`);
const { data } = concept;
const { Content, headings } = await render(concept);
const all = (await getCollection('concepts')).sort((a,b)=>a.data.order-b.data.order);
const bySlug = Object.fromEntries(all.map(c=>[c.data.slug,c]));
const current = all.findIndex(c=>c.data.slug===data.slug);
const prev = all[current-1], next = all[current+1];
const statusLabels = {draft:'Draft · 待审阅',reviewed:'Reviewed · 已审阅',stable:'Stable · 稳定', 'needs-update':'Needs Update · 待更新'};
const readingMinutes = Math.max(1, Math.ceil((concept.body?.match(/[\u3400-\u9fff]/g)?.length || 0) / 300));
const links = relationshipsFor(data.slug);
const area = knowledgeAreaById[data.knowledge_area];
const sections = headings.filter(h=>h.depth===2).map(h=>({ ...h, children: headings.slice(headings.indexOf(h)+1,headings.findIndex((n,j)=>j>headings.indexOf(h)&&n.depth===2)<0?headings.length:headings.findIndex((n,j)=>j>headings.indexOf(h)&&n.depth===2)).filter(n=>n.depth===3) }));
for (const id of data.references) { if (!references[id]) throw new Error(`Unknown reference ${id} in ${data.slug}`); }
for (const item of links) { if (!bySlug[item.neighbor]) throw new Error(`Unknown related concept ${item.neighbor} in ${data.slug}`); }
if (['reviewed','stable'].includes(data.status) && (!data.reviewer || !data.reviewed_at)) throw new Error(`Review record missing in ${data.slug}`);
---
<BaseLayout title={`${data.title} · ${data.english}`} description={data.summary}>
  <div class="container">
    <div class="breadcrumb"><a href={url('explore')}>Explore</a><span>/</span><a href={url(`domains/${data.categories[0]}`)}>{domainById[data.categories[0]].zh}</a><span>/</span><span>{data.title}</span></div>
    <div class="article-shell">
      <article data-pagefind-body>
        <header class="article-header">
          <div class="article-badges"><DepthBadge depth={data.depth} /><span class:list={['status-pill',data.status]}>{statusLabels[data.status]}</span></div>
          <h1 data-pagefind-meta="title">{data.title}</h1>
          <p class="article-english" data-pagefind-weight="5">{data.english}</p>
          <p class="lead">{data.summary}</p>
          <p class="reading-time" data-pagefind-ignore>预计阅读 {readingMinutes} 分钟 · 公式与参考文献可按需深入</p>
          <span class="sr-only" data-pagefind-weight="15">{data.aliases.join(' ')}</span>
          <span class="sr-only" data-pagefind-weight="3">{data.tags.join(' ')}</span>
          <div class="article-metadata"><span>更新 {data.last_updated.replaceAll('-','.')}</span><span>{data.authors.join(' / ') || '作者待登记'}</span><span>{data.reviewer ? `审阅：${data.reviewer} · ${data.reviewed_at}` : '尚未完成专业审阅'}<a class="feedback-shortcut" href="#feedback">帮助完善这个词条</a></span></div>
          <div class="article-tags">{data.categories.map(id=><span data-pagefind-filter={`领域:${domainById[id].zh}`}>{domainById[id].zh}</span>)}{data.tags.map(tag=><span>{tag}</span>)}</div>
        </header>
        {data.status==='draft' && <div class="draft-notice" data-pagefind-ignore>本词条为 AI 辅助编写的待审阅版本。参考文献列明引用用途与核验范围；检索记录可追溯，内容将随证据与专业审阅继续完善。</div>}
        <div class="wiki-content">
          <details class="wiki-infobox" aria-label="术语信息" data-pagefind-ignore open>
            <summary class="infobox-heading">{data.title}<small>{data.english} · 术语信息与图示</small></summary>
            {data.illustration && <figure class="infobox-figure"><a href={asset(data.illustration.src)} target="_blank" rel="noopener" aria-label="打开完整教学图"><img src={asset(data.illustration.src)} alt={data.illustration.alt} width="780" height="360" loading="lazy" /></a><figcaption>{data.illustration.caption}</figcaption></figure>}
            <dl><div><dt>词条类型</dt><dd>{kindLabels[data.kind]}</dd></div><div><dt>知识层面</dt><dd>{area.title}</dd></div>{data.key_facts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
            <a class="infobox-map-link" href={url('map')+'?concept='+data.slug}>在三维知识地图中定位 ↗</a>
          </details>
          <div class="prose wiki-prose"><Content /></div>
        </div>
        <section class="references" id="references" data-pagefind-ignore>
          <h2>参考文献与证据范围</h2>
          <ol class="reference-list">{data.references.map(id=>{const ref=references[id];return <li id={`ref-${id}`}><a class="reference-title" href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title} ↗</a><p class="reference-detail">{ref.publicationType==='preprint' && <strong class="preprint-label">预印本 · 未同行评审 · </strong>}{ref.authors} ({ref.year}). {ref.publication}.</p><div class="reference-links">{ref.doi && <a href={`https://doi.org/${ref.doi}`} target="_blank" rel="noopener noreferrer">DOI: {ref.doi}</a>}<a href={ref.url} target="_blank" rel="noopener noreferrer">{accessLabels[ref.access]} ↗</a></div><p class="source-scope">引用用途：{ref.supports}</p></li>})}</ol>
        </section>
        <section class="related-section" id="related" data-pagefind-ignore><h2>参见与关联概念</h2><p class="relation-note">关系说明区分类型、表征、机制、测量与应用；学习顺序见学习路径。</p><div class="related-list">{links.map(item=><a class="related-link" href={url(`concepts/${item.neighbor}`)}><div><strong>{bySlug[item.neighbor].data.title}</strong><span>{item.label}</span><small>{item.note}</small></div><span aria-hidden="true">↗</span></a>)}</div></section>
        <nav class="article-next" aria-label="按词条目录继续阅读" data-pagefind-ignore>{prev ? <a href={url(`concepts/${prev.data.slug}`)}>← {prev.data.title}</a> : <a href={url('learn')}>← 学习路径</a>}{next ? <a href={url(`concepts/${next.data.slug}`)}>{next.data.title} →</a> : <a href={url('learn')}>返回学习路径 →</a>}</nav>
        <FeedbackPanel title={data.title} slug={data.slug} />
      </article>
      <aside class="article-sidebar" aria-label="词条目录"><div class="toc-label">CONTENTS / 目录</div><nav>{sections.map((h,i)=><div class="wiki-toc-section"><a href={`#${h.slug}`}>{i+1}. {h.text}</a><div>{h.children.map(n=><a class="wiki-toc-sub" href={`#${n.slug}`}>{n.text}</a>)}</div></div>)}<a href="#references">参考文献与证据范围</a><a href="#related">参见与关联概念</a></nav><div class="sidebar-info">{area.title}<br />{kindLabels[data.kind]}<br /><a class="text-link" href={url('contribute')}>参与审阅 ↗</a></div></aside>
    </div>
  </div>
</BaseLayout>
<script>
const box=document.querySelector<HTMLDetailsElement>('.wiki-infobox');
const wide=matchMedia('(min-width:761px)');
if(box){box.open=wide.matches;wide.addEventListener('change',e=>{box.open=e.matches;});}
</script>
<style>
.wiki-prose :global(.section-anchor){display:block}.wiki-content{display:flow-root}.wiki-infobox{float:right;width:290px;max-width:42%;margin:5px 0 24px 25px;border:1px solid #d8e0ea;border-radius:8px;background:#f3f6fb;font-size:12px;overflow:hidden}.infobox-heading{text-align:center;background:#e7edf5;padding:16px;font-weight:650;font-size:17px}.infobox-heading small{display:block;font-size:11px;font-weight:400;margin-top:6px;color:var(--muted)}.wiki-infobox dl{padding:0 13px;margin:0}.wiki-infobox dl>div{display:grid;grid-template-columns:80px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.wiki-infobox dt{font-weight:600}.wiki-infobox dd{margin:0;line-height:1.8}.infobox-map-link{display:block;padding:14px;color:var(--accent);font-size:11px}.infobox-figure{margin:0;padding:10px}.infobox-figure img{width:100%;height:auto;background:white}.infobox-figure figcaption{font-size:10px;line-height:1.7;margin-top:8px;color:var(--muted)}.wiki-prose :global(>p:first-child){font-size:16px;line-height:2}.wiki-prose :global(a[href^="#ref-"]){font-size:.72em;vertical-align:super;white-space:nowrap;text-decoration:none;padding:0 2px}.wiki-prose :global(a[href^="#ref-"]::before){content:'['}.wiki-prose :global(a[href^="#ref-"]::after){content:']'}.wiki-prose :global(h2){border-bottom:1px solid var(--line);padding-bottom:9px;margin-top:38px}.wiki-prose :global(h3){font-size:17px;line-height:1.7;margin:25px 0 10px}.wiki-prose :global(th),.wiki-prose :global(td){min-width:130px}.related-link small{display:block;font-size:11px;font-weight:400;line-height:1.8;margin-top:6px;color:var(--muted)}.relation-note{font-size:12px;color:var(--muted);margin-bottom:20px}.wiki-toc-section>div{padding-left:13px}.article-sidebar .wiki-toc-sub{display:block;font-size:10px;margin-top:7px}.wiki-toc-section{margin-bottom:9px}
@media(max-width:1000px){.wiki-infobox{max-width:48%;width:265px}}
@media(max-width:760px){.wiki-infobox{float:none;max-width:none;width:100%;margin:0 0 26px}.wiki-infobox dl{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}.wiki-infobox dl>div{grid-template-columns:1fr}.infobox-figure{max-width:480px;margin:auto}.wiki-toc-section>div{display:none}.wiki-toc-section{margin:0}.wiki-prose :global(>p:first-child){font-size:15px}}
</style>
<style>
.article-badges{display:flex;align-items:center;flex-wrap:wrap;gap:10px}
.feedback-shortcut{margin-left:8px;font-size:inherit;color:var(--accent);text-decoration:underline;text-underline-offset:3px}
.wiki-prose :global(.pitch-figure),.wiki-prose :global(.encyclopedia-figure){clear:both;margin:28px 0;width:100%;background:#fff}
.wiki-prose :global(.pitch-figure img),.wiki-prose :global(.encyclopedia-figure img){display:block;width:100%;height:auto;margin:0;border-radius:0}
.wiki-prose :global(.pitch-figure figcaption),.wiki-prose :global(.encyclopedia-figure figcaption){font-size:12px;line-height:1.9;margin-top:12px;color:var(--muted)}
.wiki-prose :global(.pitch-figure a),.wiki-prose :global(.encyclopedia-figure a){display:block}
.wiki-prose :global(.pitch-figure figcaption a),.wiki-prose :global(.encyclopedia-figure figcaption a){display:inline}
</style>
