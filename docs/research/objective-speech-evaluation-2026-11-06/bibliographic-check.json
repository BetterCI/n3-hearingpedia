  {
    "doi": "10.1121/10.0017546",
    "status": 200,
    "title": [
      "Extending the Hearing-Aid Speech Perception Index (HASPI): Keywords, sentences, and context"
    ],
    "author": [
      {
        "given": "James M.",
        "family": "Kates",
        "sequence": "first",
        "affiliation": [
          {
            "name": "Department of Speech, Language, and Hearing Sciences, University of Colorado , Boulder, Colorado 80309, USA"
